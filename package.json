{
  "name": "next2apk",
  "version": "0.1.0",
  "description": "Analyze Next.js projects before preparing Android apps with Capacitor",
  "type": "module",
  "license": "MIT",
  "bin": { "next2apk": "dist/cli/index.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "ARCHITECTURE.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build"
  },
  "dependencies": { "commander": "^14.0.0", "typescript": "^5.9.3" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.20.0" }
}
